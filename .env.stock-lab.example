# Base de prueba LOCAL del plan stock-integrity (supabase start). Copiar a .env.stock-lab.
# Las claves son las demo publicas del CLI de Supabase (JWT HS256 firmados con
# "super-secret-jwt-token-with-at-least-32-characters-long", iss supabase-demo).
# Con la base arriba se verifican con: npx supabase status (anon key / service_role key).
# Puertos 1432x y no los 5432x por defecto: en Windows el rango 54307-54406 lo reserva
# Hyper-V/WinNAT y Docker no puede publicarlos. Ver supabase/config.toml y docs/supabase-setup.md (13).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:14321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
API_DATA_SOURCE=supabase
NEXT_PUBLIC_API_DATA_SOURCE=supabase
ALLOW_DEMO_AUTH=false
NEXT_PUBLIC_ALLOW_DEMO_AUTH=false
PORT=3100
STOCK_LAB_DB_URL=postgresql://postgres:postgres@127.0.0.1:14322/postgres
STOCK_TEST_ALLOW_WRITES_HOST=127.0.0.1
